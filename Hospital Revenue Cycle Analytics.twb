      <column caption='Denial Rate' datatype='real' name='[Calculation_1913728696774656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [claim_status] = &quot;Denied&quot; THEN 1 ELSE 0 END) / COUNT([claim_id])' />
